<?xml version="1.0"?>
<!DOCTYPE pathway SYSTEM "https://www.kegg.jp/kegg/xml/KGML_v0.7.2_.dtd">
<!-- Minimal test KGML for parser validation -->
<pathway name="path:test00001" org="tst" number="00001"
         title="Test pathway"
         image="https://www.kegg.jp/test/pathway.png"
         link="https://www.kegg.jp/test/pathway">

    <!-- Gene for reaction R00001 -->
    <entry id="7" name="tst:R00001_gene" type="gene" reaction="rn:R00001">
        <graphics name="GENE_R00001" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="150" y="100" width="46" height="17"/>
    </entry>

    <!-- Gene for reaction R00002 -->
    <entry id="8" name="tst:R00002_gene" type="gene" reaction="rn:R00002">
        <graphics name="GENE_R00002" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="300" y="100" width="46" height="17"/>
    </entry>

    <!-- Single gene -->
    <entry id="1" name="tst:1111" type="gene"
        link="https://www.kegg.jp/dbget-bin/www_bget?tst:1111">
        <graphics name="GENE1, aliasA" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="100" y="100" width="46" height="17"/>
    </entry>

    <!-- Multiple genes -->
    <entry id="2" name="tst:2222 tst:3333" type="gene"
        link="https://www.kegg.jp/dbget-bin/www_bget?tst:2222+tst:3333">
        <graphics name="GENE2, GENE3" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="200" y="100" width="46" height="17"/>
    </entry>

    <!-- Ortholog -->
    <entry id="3" name="ko:K00001" type="ortholog"
        link="https://www.kegg.jp/dbget-bin/www_bget?K00001">
        <graphics name="K00001" fgcolor="#000000" bgcolor="#FFFFFF"
             type="rectangle" x="300" y="100" width="46" height="17"/>
    </entry>

    <!-- Map (reference pathway) -->
    <entry id="4" name="path:tst00002" type="map"
        link="https://www.kegg.jp/dbget-bin/www_bget?tst00002">
        <graphics name="TITLE:Test map" fgcolor="#000000" bgcolor="#FFFFFF"
             type="roundrectangle" x="400" y="100" width="100" height="25"/>
    </entry>

    <!-- Compound -->
    <entry id="10" name="cpd:C00001" type="compound"
        link="https://www.kegg.jp/dbget-bin/www_bget?cpd:C00001">
        <graphics name="COMPOUND1" fgcolor="#000000" bgcolor="#FFFFCC"
             type="circle" x="100" y="200" width="30" height="30"/>
    </entry>

    <!-- Added compounds for reactions -->
    <entry id="11" name="cpd:C00002" type="compound"
        link="https://www.kegg.jp/dbget-bin/www_bget?cpd:C00002">
        <graphics name="C00002" fgcolor="#000000" bgcolor="#FFFFCC"
             type="circle" x="200" y="200" width="30" height="30"/>
    </entry>

    <entry id="12" name="cpd:C00003" type="compound"
        link="https://www.kegg.jp/dbget-bin/www_bget?cpd:C00003">
        <graphics name="C00003" fgcolor="#000000" bgcolor="#FFFFCC"
             type="circle" x="300" y="200" width="30" height="30"/>
    </entry>

    <entry id="13" name="cpd:C00004" type="compound"
        link="https://www.kegg.jp/dbget-bin/www_bget?cpd:C00004">
        <graphics name="C00004" fgcolor="#000000" bgcolor="#FFFFCC"
             type="circle" x="400" y="200" width="30" height="30"/>
    </entry>

    <entry id="14" name="cpd:C00005" type="compound"
        link="https://www.kegg.jp/dbget-bin/www_bget?cpd:C00005">
        <graphics name="C00005" fgcolor="#000000" bgcolor="#FFFFCC"
             type="circle" x="500" y="200" width="30" height="30"/>
    </entry>

    <entry id="15" name="cpd:C00006" type="compound"
        link="https://www.kegg.jp/dbget-bin/www_bget?cpd:C00006">
        <graphics name="C00006" fgcolor="#000000" bgcolor="#FFFFCC"
             type="circle" x="600" y="200" width="30" height="30"/>
    </entry>

    <!-- Line node -->
    <entry id="41" name="tst:1111 tst:2222 tst:3333" type="gene" reaction="rn:R00001" link="https://www.kegg.jp/dbget-bin/www_bget?tst:1111+tst:2222+tst:3333">
      <graphics name="GENE1, GENE2, GENE3..." fgcolor="#66CC66" bgcolor="#FFFFFF" type="line" coords="100,150,200,150"/>
    </entry>

    <!-- Group combining multiple genes -->
    <entry id="5" name="undefined" type="group">
        <graphics fgcolor="#000000" bgcolor="#FFFFFF"
             type="rectangle" x="150" y="200" width="80" height="17"/>
        <component id="1"/>
        <component id="2"/>
    </entry>

    <!-- Gene repeated elsewhere -->
    <entry id="6" name="tst:1111" type="gene"
        link="https://www.kegg.jp/dbget-bin/www_bget?tst:1111">
        <graphics name="GENE1_DUPLICATE" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="100" y="300" width="46" height="17"/>
    </entry>

    <!-- Relations -->
    <relation entry1="1" entry2="2" type="PPrel">
        <subtype name="activation" value="--&gt;"/>
    </relation>
    <relation entry1="2" entry2="3" type="ECrel">
        <subtype name="compound" value="--"/>
    </relation>
    <relation entry1="3" entry2="4" type="maplink">
        <subtype name="inhibition" value="--|"/>
    </relation>
    <relation entry1="4" entry2="5" type="PPrel">
        <subtype name="expression" value="..&gt;"/>
    </relation>
    
    <!-- Circular relation -->
    <relation entry1="5" entry2="1" type="PPrel">
        <subtype name="feedback" value="--o"/>
    </relation>

    <!-- Reactions -->
    <reaction id="7" name="rn:R00001" type="irreversible">
      <substrate id="10" name="cpd:C00001"/>
      <product id="11" name="cpd:C00002"/>
    </reaction>

    <reaction id="9" name="rn:R00003" type="irreversible">
      <substrate id="10" name="cpd:C00001"/>
      <product id="11" name="cpd:C00002"/>
    </reaction>

    <reaction id="8" name="rn:R00002" type="reversible">
      <substrate id="12" name="cpd:C00003"/>
      <substrate id="13" name="cpd:C00004"/>
      <product id="14" name="cpd:C00005"/>
      <product id="15" name="cpd:C00006"/>
    </reaction>

</pathway>