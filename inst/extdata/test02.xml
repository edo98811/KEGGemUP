<?xml version="1.0"?>
<!DOCTYPE pathway SYSTEM "https://www.kegg.jp/kegg/xml/KGML_v0.7.2_.dtd">
<pathway name="path:test00001" org="tst" number="00001"
         title="Test pathway (Full Edge Cases)"
         image="https://www.kegg.jp/test/pathway_full.png"
         link="https://www.kegg.jp/test/pathway">

    <!-- Single gene -->
    <entry id="1" name="tst:1111" type="gene"
           link="https://www.kegg.jp/dbget-bin/www_bget?tst:1111">
        <graphics name="GENE1, aliasA" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="100" y="100" width="46" height="17"/>
    </entry>

    <!-- Multiple genes -->
    <entry id="2" name="tst:2222 tst:3333" type="gene"
           link="https://www.kegg.jp/dbget-bin/www_bget?tst:2222+tst:3333">
        <graphics name="GENE2, GENE3" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="200" y="100" width="46" height="17"/>
    </entry>

    <!-- Ortholog -->
    <entry id="3" name="ko:K00001" type="ortholog"
           link="https://www.kegg.jp/dbget-bin/www_bget?K00001">
        <graphics name="K00001" fgcolor="#000000" bgcolor="#FFFFFF"
             type="rectangle" x="300" y="100" width="46" height="17"/>
    </entry>

    <!-- Map (reference pathway) -->
    <entry id="4" name="path:tst00002" type="map"
           link="https://www.kegg.jp/dbget-bin/www_bget?tst00002">
        <graphics name="TITLE:Test map" fgcolor="#000000" bgcolor="#FFFFFF"
             type="roundrectangle" x="400" y="100" width="100" height="25"/>
    </entry>

    <!-- Enzyme entry -->
    <entry id="5" name="ec:1.1.1.1" type="enzyme"
           link="https://www.kegg.jp/dbget-bin/www_bget?ec:1.1.1.1">
        <graphics name="EC1" fgcolor="#FFFFFF" bgcolor="#0000FF" type="ellipse" x="500" y="100" width="46" height="17"/>
    </entry>

    <!-- Compound entry -->
    <entry id="6" name="cpd:C00001" type="compound"
         link="https://www.kegg.jp/dbget-bin/www_bget?C00001">
      <graphics name="Compound1" fgcolor="#000000" bgcolor="#FFCCCC" type="circle" x="600" y="100" width="30" height="30"/>
    </entry>

    <!-- Non-existent compound -->
    <entry id="8" name="cpd:C99999" type="compound"
         link="https://www.kegg.jp/dbget-bin/www_bget?C99999">
      <graphics name="NonExistentCompound" fgcolor="#000000" bgcolor="#FFCCCC" type="circle" x="650" y="100" width="30" height="30"/>
    </entry>


    <!-- Group combining multiple genes -->
    <entry id="7" name="undefined" type="group">
        <graphics fgcolor="#000000" bgcolor="#FFFFFF" type="rectangle" x="150" y="200" width="80" height="17"/>
        <component id="1"/>
        <component id="2"/>
    </entry>

    <!-- Line node -->
    <entry id="9" name="tst:1111,tst:2222 tst:3333" type="gene" reaction="rn:R00001"
           link="https://www.kegg.jp/dbget-bin/www_bget?tst:1111+tst:2222+tst:3333">
        <graphics name="GENE1, GENE2, GENE3..." fgcolor="#66CC66" bgcolor="#FFFFFF" type="line" coords="100,150,200,150"/>
    </entry>

    <!-- Gene repeated elsewhere -->
    <entry id="10" name="tst:1111" type="gene"
           link="https://www.kegg.jp/dbget-bin/www_bget?tst:1111">
        <graphics name="GENE1_DUPLICATE" fgcolor="#000000" bgcolor="#BFFFBF"
             type="rectangle" x="100" y="300" width="46" height="17"/>
    </entry>

    <!-- Entry with undefined type -->
    <entry id="11" name="unknown_entry" type="unknown">
        <graphics name="UNKNOWN" fgcolor="#000000" bgcolor="#AAAAAA" type="diamond" x="700" y="150" width="20" height="20"/>
    </entry>

    <!-- Relations covering all types -->
    <relation entry1="1" entry2="2" type="PPrel">
        <subtype name="activation" value="--&gt;"/>
    </relation>
    <relation entry1="2" entry2="3" type="ECrel">
        <subtype name="compound" value="--"/>
        <subtype name="reversible" value="=&gt;"/>
    </relation>
    <relation entry1="3" entry2="4" type="maplink">
        <subtype name="inhibition" value="--|"/>
    </relation>
    <relation entry1="4" entry2="5" type="PPrel">
        <subtype name="expression" value="..&gt;"/>
    </relation>
    <relation entry1="5" entry2="1" type="PPrel">
        <subtype name="feedback" value="--o"/>
    </relation>
    <relation entry1="6" entry2="5" type="GErel">
        <subtype name="phosphorylation" value="--&gt;"/>
    </relation>

    <!-- Reactions -->
    <reaction id="12" name="rn:R00001" type="irreversible">
        <substrate id="1" name="cpd:C00001"/>
        <product id="2" name="cpd:C00002"/>
    </reaction>

    <reaction id="13" name="rn:R00002" type="reversible">
        <substrate id="2" name="cpd:C00003"/>
        <substrate id="3" name="cpd:C00004"/>
        <product id="4" name="cpd:C00005"/>
        <product id="5" name="cpd:C00006"/>
    </reaction>

    <reaction id="14" name="rn:R00003" type="irreversible">
        <substrate id="5" name="cpd:C00007"/>
        <product id="6" name="cpd:C00008"/>
        <cofactor id="7" name="cpd:C00009"/>
    </reaction>

    <!-- Bracket type graphics -->
    <entry id="15" name="tst:5555" type="gene">
        <graphics name="GENE_BRACKET" fgcolor="#000000" bgcolor="#FFFFFF" type="bracket" x="800" y="200" width="50" height="20"/>
    </entry>

</pathway>
